PORT=3333
# development | test | production. Em production, TRUST_PROXY_HOPS e SUPABASE_URL https são obrigatórios.
NODE_ENV=development
# Postgres do Supabase (connection pooler). Credencial de servidor: nunca vai ao front.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lagoa
# O JWT do Supabase Auth é validado pelo JWKS público desse projeto.
SUPABASE_URL=https://<project>.supabase.co
# Chaves de cifra/hash de dado pessoal (celular e e-mail). Gere com: openssl rand -base64 32
PII_ENCRYPTION_KEY=
PII_HASH_PEPPER=
# Login por SMS: o Supabase gera o código e chama POST /v1/auth/hooks/send-sms (Auth > Hooks > Send SMS);
# a API entrega pela Comtele. Em production os dois são obrigatórios.
COMTELE_AUTH_KEY=
COMTELE_ROUTE=17
SEND_SMS_HOOK_SECRET=
# Proxies na frente da API (0 local; 1 atrás de um load balancer). Errado = limite de requisições pelo IP errado.
# Obrigatório em production.
TRUST_PROXY_HOPS=0
# Segredo do BFF do Nuxt (mesmo valor em NUXT_BFF_SHARED_SECRET). Gere com: openssl rand -base64 32
# Com ele a API usa o IP real do cliente no limite por IP; sem ele, todo mundo parece vir do BFF.
BFF_SHARED_SECRET=
CORS_ORIGIN=http://localhost:3000
# Só em .env de banco de dev: libera `pnpm db:seed`.
# ALLOW_SEED=true
# Só em .env de banco de dev: libera `pnpm --filter @lagoa/api visit-qr:dev <código da loja> [centavos]`, que emite um QR da visita.
# ALLOW_DEV_VISIT_QR=1
# APP_URL=http://localhost:3000

# Só em dev/teste: liga POST /v1/merchant/shop/test-approve (a loja se aprova sozinha). Proibido em production.
ENABLE_TEST_APPROVE=0
# Gate do termo do lojista (merchantTermsNotAccepted). Só ligue quando o texto do jurídico e a tela de aceite existirem (P-M7).
MERCHANT_TERMS_REQUIRED=0
