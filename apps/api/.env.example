PORT=3333
# Postgres do Supabase (connection pooler). Credencial de servidor: nunca vai ao front.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lagoa
# O JWT do Supabase Auth é validado pelo JWKS público desse projeto.
SUPABASE_URL=https://<project>.supabase.co
# Chaves de cifra/hash de dado pessoal (celular e e-mail). Gere com: openssl rand -base64 32
PII_ENCRYPTION_KEY=
PII_HASH_PEPPER=
CORS_ORIGIN=http://localhost:3000
