{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "../..",
    "incremental": true,
    "paths": {
      "#shared/*": ["../../shared/*"]
    },
    "types": ["node"]
  },
  "include": ["src", "test", "drizzle.config.ts"]
}
