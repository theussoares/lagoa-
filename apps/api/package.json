{
  "name": "@lagoa/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --require @swc-node/register src/main.ts",
    "build": "rm -rf dist && cd ../.. && apps/api/node_modules/.bin/swc apps/api/src shared --config-file apps/api/.swcrc -d apps/api/dist --ignore \"**/*.test.ts\"",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env --require @swc-node/register src/database/seed.ts",
    "db:backfill-visits": "node --env-file-if-exists=.env --require @swc-node/register src/database/backfill-card-visits.ts",
    "shop:status": "node --env-file-if-exists=.env --require @swc-node/register src/database/shop-status.ts",
    "visit-qr:dev": "node --env-file-if-exists=.env --require @swc-node/register src/database/dev-issue-visit-qr.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/check-db-parity.mjs",
    "db:migrate:prod": "bash scripts/migrate-prod.sh"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
