{
  // Testes de página (ambiente Nuxt): usam auto-imports, `.vue` e `#imports`, então herdam o tsconfig gerado pelo Nuxt.
  // O resto dos testes é checado por `tsc -p tsconfig.test.json`.
  "extends": "./.nuxt/tsconfig.app.json",
  "compilerOptions": { "noEmit": true },
  "include": [
    "./.nuxt/nuxt.d.ts",
    "./app/**/*",
    "./layers/*/app/**/*",
    "./layers/core/i18n/**/*",
    "./layers/*/test/**/*.nuxt.ts",
    "./layers/*/test/**/*.nuxt.test.ts"
  ]
}
