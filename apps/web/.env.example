# 'mock' (padrão): tudo no navegador. 'http': o cliente usa a API real; o painel do lojista segue no mock.
NUXT_PUBLIC_API_MODE=mock
# Só no modo http:
NUXT_PUBLIC_API_BASE_URL=https://lagoa-api.vercel.app/v1
NUXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Chave pública (publishable/anon) do projeto: pode ir ao navegador. Nunca a service_role.
NUXT_PUBLIC_SUPABASE_ANON_KEY=
