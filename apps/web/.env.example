# O app do cliente sempre usa a API real, via BFF (SSR + cookie httpOnly). Só o painel do lojista segue no mock do navegador.
# URL do projeto Supabase (não é segredo): foto do bucket público e login (no servidor).
NUXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Estas três ficam no SERVIDOR do Nuxt (BFF em `server/`) e nunca vão ao navegador.
NUXT_API_BASE_URL=https://lagoa-api.vercel.app/v1
# Chave pública (publishable/anon) do projeto. Nunca a service_role.
NUXT_SUPABASE_ANON_KEY=
# Segredo do BFF (mesmo valor de BFF_SHARED_SECRET na API): a API passa a ver o IP real do cliente. Gere com: openssl rand -base64 32
NUXT_BFF_SHARED_SECRET=
# Origens extras com permissão de escrita em /api (separadas por vírgula). O próprio host já vale.
NUXT_ALLOWED_ORIGINS=
